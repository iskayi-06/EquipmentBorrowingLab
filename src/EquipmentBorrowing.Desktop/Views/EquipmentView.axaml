<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid ColumnDefinitions="2*, 1*" Margin="20">
        
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
            <DockPanel>
                <TextBlock Text="Available Equipment" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" DockPanel.Dock="Top"/>
                
                <ListBox ItemsSource="{Binding EquipmentList}" 
                         SelectedItem="{Binding SelectedEquipment}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="10,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                <TextBlock Text="Borrow Equipment" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Student ID:" FontWeight="SemiBold"/>
                <TextBox PlaceholderText="Eneter Student ID..." Text="{Binding StudentId}"/>
                <TextBlock Text="Expected Return Date:" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding ReturnDate}" />

                <Button Content="Borrow Equipment" 
                        Command="{Binding BorrowCommand}"
                        Background="#0078D7" Foreground="White" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,20,0,0"/>

                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="Red" TextWrapping="Wrap" 
                           Margin="0,10,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</UserControl>