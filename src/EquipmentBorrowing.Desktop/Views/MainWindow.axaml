<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Equipment Borrowing System"
        Width="800" Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F4F6">
        
        <TabControl Margin="10">
            <TabItem Header="Available Equipment" FontSize="16">
                <views:EquipmentView DataContext="{Binding EquipmentViewModel}" />
            </TabItem>

            <TabItem Header="Active Borrowings" FontSize="16">
                <TextBlock Text="Borrowings List will go here..." 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="20" Foreground="Gray"/>
            </TabItem>
        </TabControl>
        
    </Grid>
</Window>